# Copy to scripts/tier2.env (gitignored) and fill in.
#
# These are the Tier-2 identifiers secret-scan.sh greps the tracked tree for.
# They live here rather than inside the script because the script is committed
# to a public repo, and a scanner that hardcodes the values it protects
# publishes them.
#
# In CI, write this file from repository secrets before running the scan:
#   printf 'AWS_ACCOUNT_ID=%s\n' "${{ secrets.AWS_ACCOUNT_ID }}" > scripts/tier2.env
#
# Every value is re-derivable; see docs/LOCAL-VALUES.example.md for the commands.

AWS_ACCOUNT_ID=
METASTORE_ID=
DBX_WORKSPACE_ID=
WAREHOUSE_ID=
MEMBER_ROOT_EMAIL=
