# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# ...except the committed environment files. envs/*.tfvars holds identifiers
# only — workspace URL, warehouse id, pinned wheel versions — and CI runs
# `terraform plan -var-file=envs/dev.tfvars`, so an ignored file here means a
# plan that fails on a missing var-file. Secrets live in Secrets Manager and are
# read as data sources; nothing sensitive is ever written to a tfvars file.
!envs/*.tfvars

# ...but never the local overrides. This rule comes AFTER the negation above
# because the last matching pattern wins. envs/*.local.tfvars holds the AWS
# account id, workspace URL and warehouse id — identifiers that do not belong in
# a public repo.
envs/*.local.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Python test artifacts (tests/ is pytest, not Terraform)
__pycache__/
*.py[cod]
.pytest_cache/

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout
# Plan artifacts - contain full resource detail, regenerate with terraform plan
tf.plan
plan.txt

docs/LOCAL-VALUES.md
*.tfstate*
.env
changelog/liquibase.properties
*.pem
*.key
